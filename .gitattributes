# same raw bytes on Windows, Linux, and macOS.
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.txt text eol=lf
